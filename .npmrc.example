# Copy to .npmrc (gitignored). Do not put tokens here.
# Auth belongs in ~/.npmrc:
#   pnpm config set //npm.pkg.github.com/:_authToken ghp_xxxxxxxxxxxx
#
# GitHub Packages — other product repos install @mawsoftwares/* from here.
# Inside this monorepo, pnpm links local packages via workspace:*.
@mawsoftwares:registry=https://npm.pkg.github.com

# pnpm settings
auto-install-peers=true
strict-peer-dependencies=false
shamefully-hoist=true
link-workspace-packages=true
