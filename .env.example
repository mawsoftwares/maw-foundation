# ---------- Environment ----------
# Copy this to .env and fill in real values.
# NEVER commit .env — it is in .gitignore.

# App
NODE_ENV=development
PORT=4000
APP_NAME=MAW Application
APP_VERSION=0.1.0

# Database (PostgreSQL)
DATABASE_URL=postgres://user:password@localhost:5432/maw_dev
DATABASE_SSL=false

# Auth / JWT
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800

# Redis (optional — for sessions, rate limiting, queues)
REDIS_URL=redis://localhost:6379

# Email (SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@example.com
SMTP_PASS=change-me

# File storage
FILE_STORAGE_DRIVER=local
FILE_STORAGE_PATH=./uploads
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# Feature flags (external providers)
# FEATURE_FLAG_PROVIDER=local

# Logging
LOG_LEVEL=info

# GitHub Packages (CI only)
# NODE_AUTH_TOKEN=ghp_xxxxxxxxxxxx
