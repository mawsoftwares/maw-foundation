    "@mawsoftwares/sdk": "workspace:*",
    "@mawsoftwares/theme": "workspace:*",
    "@mawsoftwares/ui-auth": "workspace:*",
    "@mawsoftwares/ui-users": "workspace:*",
    "@mawsoftwares/import-export": "workspace:*",
    "@mawsoftwares/ui-web": "workspace:*",
    "@reduxjs/toolkit": "^2.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-redux": "^9.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^35.0.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^3.0.0",
    "typescript": "^5.7.3",
    "vite": "^6.0.0"
