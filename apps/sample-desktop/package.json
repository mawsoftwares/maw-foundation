{
  "name": "@mawsoftwares/sample-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:tailwind": "VITE_UI_KIT=tailwind electron-vite dev",
    "build": "electron-vite build",
    "build:tailwind": "VITE_UI_KIT=tailwind electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:mac:universal": "electron-builder --mac --universal",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux"
  },
  "devDependencies": {
    "@mawsoftwares/api": "workspace:*",
    "@mawsoftwares/api-client": "workspace:*",
    "@mawsoftwares/import-export": "workspace:*",
    "@mawsoftwares/platform": "workspace:*",
    "@mawsoftwares/rbac-core": "workspace:*",
    "@mawsoftwares/sdk": "workspace:*",
    "@mawsoftwares/theme": "workspace:*",
    "@mawsoftwares/ui-auth": "workspace:*",
    "@mawsoftwares/ui-contract": "workspace:*",
    "@mawsoftwares/ui-web": "workspace:*",
    "@mawsoftwares/ui-web-tailwind": "workspace:*",
    "@reduxjs/toolkit": "^2.5.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^35.0.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^3.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-redux": "^9.2.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.7.3",
    "vite": "^6.0.0"
  }
}
