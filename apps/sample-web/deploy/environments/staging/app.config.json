{
  "name": "staging",
  "type": "staging",
  "kind": "frontend",
  "hosting": {
    "topology": "shared-subpath"
  },
  "server": "66.116.243.198",
  "deployPath": "/home/deploy/staging/maw-foundation/web",
  "generatedSubPath": "deployment-config-web",
  "domain": "apps.mawsoftwares.in",
  "ports": {
    "backend": 4101
  },
  "static": {
    "localDist": "dist",
    "basePath": "/maw-foundation",
    "apiProxy": {
      "enabled": true,
      "backendPort": 4101
    },
    "nginx": {
      "autoInstall": true,
      "confirmBeforeInstall": true,
      "snippetDir": "/home/deploy/nginx/snippets/apps.mawsoftwares.in",
      "snippetName": "maw-foundation"
    }
  },
  "ssh": {
    "user": "deploy",
    "keyPath": "~/.ssh/mac_to_doserver"
  },
  "deployment": {
    "requiredEnv": ["VITE_API_BASE_URL", "VITE_BASE_PATH"],
    "commands": {
      "build": "npm run build"
    }
  }
}
