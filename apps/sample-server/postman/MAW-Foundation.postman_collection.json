    {
      "name": "2. User",
      "description": "`GET /me` returns the current user plus their `permissions` list (UI permission payload). `GET /admin/users` is the admin user list, gated by `Read_Users` + admin audience.",
      "item": [
        {
          "name": "GET Me",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('returns current user + permissions', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.userId).to.be.a('string');",
                  "  pm.expect(body.tenantId).to.be.a('string');",
                  "  pm.expect(body.role).to.be.a('string');",
                  "  pm.expect(body.permissions).to.be.an('array');",
                  "  pm.collectionVariables.set('sessionRole', body.role);",
                  "  pm.collectionVariables.set('userId', body.userId);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/me",
              "host": ["{{baseUrl}}"],
              "path": ["me"]
            },
            "description": "Requires Bearer token. Payload: `{ userId, tenantId, role, audience, permissions }`. Use `permissions` for UI gates (`Action_Module` codes)."
          },
          "response": [
            {
              "name": "200 Manager",
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"userId\": \"u-manager\",\n  \"tenantId\": \"demo-tenant\",\n  \"role\": \"manager\",\n  \"audience\": \"admin\",\n  \"permissions\": [\"Read_Reports\", \"Create_Reports\", \"Read_Orders\", \"Create_Orders\", \"Update_Orders\", \"Read_Inventory\", \"Create_Billing\", \"Read_AuditLogs\"]\n}"
            }
          ]
        },
        {
          "name": "GET Me (no token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('requires bearer token', function () {",
                  "  pm.response.to.have.status(401);",
                  "  pm.expect(pm.response.json().error).to.eql('missing bearer token');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/me",
              "host": ["{{baseUrl}}"],
              "path": ["me"]
            }
          }
        },
        {
          "name": "GET Admin Users",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const code = pm.response.code;",
                  "const role = pm.collectionVariables.get('sessionRole');",
                  "pm.test('200 or 403', function () {",
                  "  pm.expect([200, 403]).to.include(code);",
                  "});",
                  "if (role === 'owner') {",
                  "  pm.test('owner can read users', function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json().users).to.be.an('array');",
                  "  });",
                  "} else if (role === 'manager') {",
                  "  pm.test('manager lacks Read_Users', function () {",
                  "    pm.response.to.have.status(403);",
                  "    pm.expect(pm.response.json().permission).to.eql('Read_Users');",
                  "  });",
                  "} else if (role === 'clerk') {",
                  "  pm.test('clerk is wrong audience', function () {",
                  "    pm.response.to.have.status(403);",
                  "    pm.expect(pm.response.json().error).to.eql('wrong audience');",
                  "  });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/admin/users",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "users"]
            },
            "description": "`requireAuth` + `audienceGuard('admin')` + `requirePermission('Read_Users')`.\n\n- Owner → 200 (superuser bypass)\n- Manager → 403 `{ error, permission: \"Read_Users\", reason }`\n- Clerk → 403 `{ error: \"wrong audience\", expected: \"admin\" }`"
          }
        }
      ]
    },
    {
      "name": "3. RBAC / modules",
      "description": "Each route is gated with `requirePermission('Action_Module')` from the module registry. Run a login first, then hit these with that role.",
      "item": [
        {
          "name": "GET Reports",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const role = pm.collectionVariables.get('sessionRole');",
                  "const code = pm.response.code;",
                  "pm.test('200 or 403', function () {",
                  "  pm.expect([200, 403]).to.include(code);",
                  "});",
                  "if (role === 'clerk') {",
                  "  pm.test('clerk denied Read_Reports', function () {",
                  "    pm.response.to.have.status(403);",
                  "    pm.expect(pm.response.json().permission).to.eql('Read_Reports');",
                  "  });",
                  "} else if (role === 'owner' || role === 'manager') {",
                  "  pm.test(role + ' can read reports', function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json().report).to.be.a('string');",
                  "  });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/reports",
              "host": ["{{baseUrl}}"],
              "path": ["reports"]
