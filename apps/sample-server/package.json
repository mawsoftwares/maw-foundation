{
  "name": "@mawsoftwares/sample-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@mawsoftwares/api": "*",
    "@mawsoftwares/audit": "*",
    "@mawsoftwares/communication": "*",
    "@mawsoftwares/observability": "*",
    "@mawsoftwares/database": "*",
    "@mawsoftwares/auth-core": "*",
    "@mawsoftwares/import-export": "*",
    "@mawsoftwares/masters": "*",
    "@mawsoftwares/queue": "*",
    "@mawsoftwares/rbac-core": "*",
    "@mawsoftwares/reporting": "*",
    "@mawsoftwares/sdk": "*",
    "@mawsoftwares/server-express": "*",
    "@mawsoftwares/users": "*",
    "express": "^5.0.0",
    "multer": "^2.2.0",
    "pg": "^8.16.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.7.0",
    "@types/pg": "^8.11.0",
    "tsx": "^4.19.0"
  },
  "scripts": {
    "dev": "node --env-file=.env --import=tsx src/main.ts",
    "start": "node --env-file=.env --import=tsx src/main.ts",
    "db:migrate": "node --env-file=.env --import=tsx src/db/migrate.ts",
    "db:seed": "node --env-file=.env --import=tsx src/db/seed.ts",
    "db:test": "node --env-file=.env --import=tsx src/db/test-connection.ts",
    "db:setup": "npm run db:migrate && npm run db:seed",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  }
}
