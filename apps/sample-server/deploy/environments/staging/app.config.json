{
  "name": "staging",
  "type": "staging",
  "kind": "backend",
  "hosting": {
    "topology": "proxied-subpath"
  },
  "branch": "main",
  "server": "66.116.243.198",
  "deployPath": "/home/deploy/staging/maw-foundation",
  "generatedSubPath": "deployment-config",
  "processManager": {
    "name": "maw-sample-server-staging"
  },
  "ports": {
    "backend": 4101
  },
  "domain": "apps.mawsoftwares.in",
  "database": {
    "name": "mawfoundation_uat_db",
    "user": "mawfoundation_uat_user",
    "host": "103.211.202.236",
    "port": 5432
  },
  "features": {},
  "runtime": {
    "startScript": "apps/sample-server/src/main.ts",
    "interpreter": "node",
    "interpreterArgs": "--import=tsx",
    "instances": 1,
    "execMode": "fork",
    "maxMemoryRestart": "500M"
  },
  "ssh": {
    "user": "deploy",
    "keyPath": "~/.ssh/mac_to_doserver",
    "shellInit": "source ~/.nvm/nvm.sh"
  },
  "deployment": {
    "projectRoot": "/home/deploy/staging/maw-foundation",
    "repoUrl": "git@github.com:YOUR_ORG/maw-foundation.git",
    "pm2Command": "pm2 startOrReload {{ecosystemPath}}",
    "requiredEnv": ["JWT_SECRET"],
    "commands": {
      "pull": "git fetch origin && git checkout -B main origin/main",
      "install": "npm install",
      "build": "npm run -w @mawsoftwares/sample-server typecheck",
      "migrate": "node packages/deployment/scripts/run-with-deploy-env.js deployment-config/.env npm run -w @mawsoftwares/sample-server db:migrate"
    }
  },
  "health": {
    "protocol": "http",
    "endpoint": "/health"
  }
}
