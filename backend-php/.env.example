APP_NAME="MAW Foundation"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8081

# Same database as Node.js backend
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=maw_foundation
DB_USERNAME=postgres
DB_PASSWORD=

# Vite sample-web (and common local ports). Comma-separated.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# JWT — must match Node.js backend exactly
JWT_SECRET=dev-only-secret-change-me
JWT_TTL=900
JWT_ALGORITHM=HS256

# Password hashing — must match Node.js scrypt params
SCRYPT_N=16384
SCRYPT_R=8
SCRYPT_P=1
SCRYPT_KEY_LENGTH=64
SCRYPT_SALT_LENGTH=16

# Session
SESSION_DRIVER=database
# The schema is owned by the Node migrations (no `cache` table), so don't use the database cache store.
CACHE_STORE=file
SESSION_LIFETIME=120

# Queue
QUEUE_CONNECTION=database

# File storage
FILESYSTEM_DISK=local

# Redis (optional — for rate limiting, cache)
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Logging
LOG_CHANNEL=stack
LOG_LEVEL=debug

# Multi-tenancy
TENANT_RESOLVER=header
TENANT_HEADER=x-tenant-id

# Security
REQUIRE_PREHASH=false
CSRF_ENABLED=true
RATE_LIMIT_ENABLED=true

# --- MAW Storage (same variables and defaults as the Node backend) ---
# When Node and PHP serve the same deployment these MUST match the Node values.
# STORAGE_ENCRYPTION_KEY=          # 64 hex chars (AES-256-GCM for provider credentials); falls back to MFA_ENCRYPTION_KEY
# STORAGE_LOCAL_SIGNING_SECRET=    # >=16 chars; falls back to JWT_SECRET
# STORAGE_LOCAL_ROOT=              # local-provider root (default storage/app/maw-storage)
# PUBLIC_URL=http://localhost:8000 # origin used in local signed URLs
# STORAGE_UPLOAD_URL_TTL_SECONDS=900
# STORAGE_DOWNLOAD_URL_TTL_SECONDS=300
# STORAGE_MAX_FILE_SIZE_BYTES=104857600
# STORAGE_ALLOWED_MIME_TYPES=image/*,application/pdf
# STORAGE_PENDING_UPLOAD_MAX_AGE_HOURS=24
# STORAGE_CLEANUP_INTERVAL_MINUTES=60   # 0 disables the scheduled `storage:cleanup`

