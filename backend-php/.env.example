APP_NAME="MAW Foundation"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Same database as Node.js backend
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=maw_foundation
DB_USERNAME=postgres
DB_PASSWORD=

# JWT — must match Node.js backend exactly
JWT_SECRET=dev-only-secret-change-me
JWT_TTL=900
JWT_ALGORITHM=HS256

# Password hashing — must match Node.js scrypt params
SCRYPT_N=16384
SCRYPT_R=8
SCRYPT_P=1
SCRYPT_KEY_LENGTH=64
SCRYPT_SALT_LENGTH=16

# Session
SESSION_DRIVER=database
SESSION_LIFETIME=120

# Queue
QUEUE_CONNECTION=database

# File storage
FILESYSTEM_DISK=local

# Redis (optional — for rate limiting, cache)
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Logging
LOG_CHANNEL=stack
LOG_LEVEL=debug

# Multi-tenancy
TENANT_RESOLVER=header
TENANT_HEADER=x-tenant-id

# Security
REQUIRE_PREHASH=false
CSRF_ENABLED=true
RATE_LIMIT_ENABLED=true
