{
  "name": "maw-foundation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Reusable foundation for MAW products — one shared auth + RBAC + kernel core driving React Native mobile, React/Next web, and Node backends.",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "pnpm -r --filter './packages/**' --filter './adapters/**' run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:unit": "vitest run --exclude '**/*.integration.test.ts'",
    "test:integration": "vitest run --include '**/*.integration.test.ts'",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "verify": "pnpm typecheck && pnpm lint && pnpm test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "sample:server": "pnpm --filter @mawsoftwares/sample-server dev",
    "sample:web": "pnpm --filter @mawsoftwares/sample-web dev",
    "deploy:server": "node packages/deployment/bin/maw-deploy.js --project-root apps/sample-server",
    "deploy:web": "node packages/deployment/bin/maw-deploy.js --project-root apps/sample-web",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.0",
    "@eslint/js": "^9.39.0",
    "@types/node": "^24.7.0",
    "eslint": "^9.39.0",
    "prettier": "^3.5.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "@vitest/coverage-v8": "^3.0.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
