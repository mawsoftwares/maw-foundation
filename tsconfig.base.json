{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "sourceMap": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@mawsoftwares/sdk": ["packages/sdk/src/index.ts"],
      "@mawsoftwares/sdk/*": ["packages/sdk/src/*"],
      "@mawsoftwares/core": ["packages/core/src/index.ts"],
      "@mawsoftwares/config": ["packages/config/src/index.ts"],
      "@mawsoftwares/platform": ["packages/platform/src/index.ts"],
      "@mawsoftwares/platform/*": ["packages/platform/src/*"],
      "@mawsoftwares/platform/native": ["packages/platform/src/native/index.ts"],
      "@mawsoftwares/rbac-core": ["packages/rbac-core/src/index.ts"],
      "@mawsoftwares/rbac-core/*": ["packages/rbac-core/src/*"],
      "@mawsoftwares/auth-core": ["packages/auth-core/src/index.ts"],
      "@mawsoftwares/auth-core/*": ["packages/auth-core/src/*"],
      "@mawsoftwares/users": ["packages/users/src/index.ts"],
      "@mawsoftwares/tenancy": ["packages/tenancy/src/index.ts"],
      "@mawsoftwares/modules": ["packages/modules/src/index.ts"],
      "@mawsoftwares/feature-flags": ["packages/feature-flags/src/index.ts"],
      "@mawsoftwares/ui-users": ["packages/ui-users/src/index.ts"],
      "@mawsoftwares/ui-users/*": ["packages/ui-users/src/*"],
      "@mawsoftwares/server-express": ["packages/server-express/src/index.ts"],
      "@mawsoftwares/server-express/*": ["packages/server-express/src/*"],
      "@mawsoftwares/server-hono": ["packages/server-hono/src/index.ts"],
      "@mawsoftwares/server-hono/*": ["packages/server-hono/src/*"],
      "@mawsoftwares/api-client": ["packages/api-client/src/index.ts"],
      "@mawsoftwares/api-client/*": ["packages/api-client/src/*"],
      "@mawsoftwares/theme": ["packages/theme/src/index.ts"],
      "@mawsoftwares/theme/*": ["packages/theme/src/*"],
      "@mawsoftwares/ui-web": ["packages/ui-web/src/index.ts"],
      "@mawsoftwares/ui-web/*": ["packages/ui-web/src/*"],
      "@mawsoftwares/ui-auth": ["packages/ui-auth/src/index.ts"],
      "@mawsoftwares/ui-auth/*": ["packages/ui-auth/src/*"],
      "@mawsoftwares/ui-native": ["packages/ui-native/src/index.ts"],
      "@mawsoftwares/ui-native/*": ["packages/ui-native/src/*"],
      "@mawsoftwares/communication": ["packages/communication/src/index.ts"],
      "@mawsoftwares/communication/*": ["packages/communication/src/*"],
      "@mawsoftwares/queue": ["packages/queue/src/index.ts"],
      "@mawsoftwares/queue/*": ["packages/queue/src/*"],
      "@mawsoftwares/import-export": ["packages/import-export/src/index.ts"],
      "@mawsoftwares/import-export/*": ["packages/import-export/src/*"],
      "@mawsoftwares/reporting": ["packages/reporting/src/index.ts"],
      "@mawsoftwares/reporting/*": ["packages/reporting/src/*"],
      "@mawsoftwares/api": ["packages/api/src/index.ts"],
      "@mawsoftwares/api/*": ["packages/api/src/*"],
      "@mawsoftwares/database": ["packages/database/src/index.ts"],
      "@mawsoftwares/database/*": ["packages/database/src/*"],
      "@mawsoftwares/masters": ["packages/masters/src/index.ts"],
      "@mawsoftwares/masters/*": ["packages/masters/src/*"],
      "@mawsoftwares/testing": ["packages/testing/src/index.ts"],
      "@mawsoftwares/testing/*": ["packages/testing/src/*"],
      "@mawsoftwares/observability": ["packages/observability/src/index.ts"],
      "@mawsoftwares/observability/*": ["packages/observability/src/*"],
      "@mawsoftwares/notifications": ["packages/notifications/src/index.ts"],
      "@mawsoftwares/audit": ["packages/audit/src/index.ts"],
      "@mawsoftwares/files": ["packages/files/src/index.ts"],
      "@mawsoftwares/validation": ["packages/validation/src/index.ts"],
      "@mawsoftwares/i18n": ["packages/i18n/src/index.ts"],
      "@mawsoftwares/workflow": ["packages/workflow/src/index.ts"],
      "@mawsoftwares/billing": ["packages/billing/src/index.ts"],
      "@mawsoftwares/offline": ["packages/offline/src/index.ts"],
      "@mawsoftwares/express": ["adapters/express/src/index.ts"],
      "@mawsoftwares/hono": ["adapters/hono/src/index.ts"],
      "@mawsoftwares/postgres": ["adapters/postgres/src/index.ts"]
    }
  }
}
