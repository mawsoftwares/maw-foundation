{
  "name": "production",
  "type": "production",
  "kind": "frontend",
  "hosting": {
    "topology": "shared-subpath"
  },
  "server": "YOUR_SERVER_IP",
  "deployPath": "/home/deploy/prod/your-app/web",
  "generatedSubPath": "deployment-config-web",
  "domain": "apps.your-domain.com",
  "ports": {
    "backend": 4101
  },
  "static": {
    "localDist": "dist",
    "basePath": "/your-app",
    "apiProxy": {
      "enabled": true,
      "backendPort": 4101
    },
    "nginx": {
      "autoInstall": true,
      "snippetDir": "/home/deploy/nginx/snippets/apps.your-domain.com",
      "snippetName": "your-app"
    }
  },
  "ssh": {
    "user": "deploy",
    "keyPath": "~/.ssh/id_rsa"
  },
  "deployment": {
    "requiredEnv": ["VITE_API_BASE_URL", "VITE_BASE_PATH"],
    "commands": {
      "build": "npm run build"
    }
  }
}
