# Approach B — Dedicated API domain
# App:  https://app.yourdomain.com/
# API:  https://api.yourdomain.com

NODE_ENV=production
PORT=8200

DB_HOST=your_db_host
DB_PORT=5432
DB_USER=classroom_prod_user
DB_PASSWORD=your_password_here
DB_NAME=classroom_prod_db
DB_SSL=false

JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

ALLOWED_ORIGINS=https://app.yourdomain.com,http://localhost:3000,http://localhost:5173
FRONTEND_BASE_URL=https://app.yourdomain.com
API_BASE_URL=https://api.yourdomain.com
API_TIMEOUT=30000

LOG_LEVEL=info

SMTP_HOST=your_smtp_host
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_smtp_user
SMTP_PASSWORD=your_smtp_password
SMTP_FROM="Your App <noreply@example.com>"
