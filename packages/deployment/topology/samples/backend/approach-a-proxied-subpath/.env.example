# Approach A — Proxied subpath (API only via frontend nginx)
# App:  https://apps.mawsoftwares.in/classroom-prod/
# API:  https://apps.mawsoftwares.in/classroom-prod/api

NODE_ENV=production
PORT=8200

DB_HOST=your_db_host
DB_PORT=5432
DB_USER=classroom_prod_user
DB_PASSWORD=your_password_here
DB_NAME=classroom_prod_db
DB_SSL=false

JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# Origin = scheme + host only (no path)
ALLOWED_ORIGINS=https://apps.mawsoftwares.in,http://localhost:3000,http://localhost:5173
# Must include subpath for QR / emails / registration links
FRONTEND_BASE_URL=https://apps.mawsoftwares.in/classroom-prod
API_BASE_URL=https://apps.mawsoftwares.in/classroom-prod
API_TIMEOUT=30000

LOG_LEVEL=info

SMTP_HOST=your_smtp_host
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_smtp_user
SMTP_PASSWORD=your_smtp_password
SMTP_FROM="Your App <noreply@example.com>"
