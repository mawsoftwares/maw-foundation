# ============================================
# Production — Approach B (dedicated-domain)
# ============================================
# Copy: cp .env.example .env
# App: https://sushmapet.apps.mawsoftwares.in/
# API: https://api.sushmapet.apps.mawsoftwares.in

NODE_ENV=production
PORT=8200

# ============================================
# Database Configuration (Production)
# ============================================
DB_HOST=your_db_host
DB_PORT=5432
DB_USER=classroom_prod_user
DB_PASSWORD=your_password_here
DB_NAME=classroom_prod_db
DB_SSL=false

# ============================================
# Session / JWT
# ============================================
SESSION_SECRET=replace_with_a_long_random_secret
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d
TRUST_PROXY=true

# ============================================
# CORS & URL Configuration
# ============================================
ALLOWED_ORIGINS=https://sushmapet.apps.mawsoftwares.in,http://localhost:3000,http://localhost:5173
FRONTEND_BASE_URL=https://sushmapet.apps.mawsoftwares.in
API_BASE_URL=https://api.sushmapet.apps.mawsoftwares.in
API_TIMEOUT=30000

# ============================================
# Seed defaults (required by seeds/002_default_superadmin.ts)
# ============================================
SUPERADMIN_EMAIL=superadmin@sushmapet.com
SUPERADMIN_PASSWORD=ChangeMeStrong1!

# ============================================
# Logging Configuration
# ============================================
LOG_LEVEL=info

# ============================================
# SMTP Configuration (Production)
# ============================================
SMTP_HOST=your_smtp_host
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_smtp_user
SMTP_PASSWORD=your_smtp_password
SMTP_FROM="Business Vidyalay <noreply@example.com>"
