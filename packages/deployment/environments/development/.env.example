# ============================================
# Development — Approach B (dedicated-domain)
# ============================================
# Copy: cp .env.example .env
# App: https://dev.your-domain.com/
# API: https://dev-api.your-domain.com

NODE_ENV=development
PORT=4100

# ============================================
# Database Configuration (Development)
# ============================================
DB_HOST=localhost
DB_PORT=5432
DB_USER=your_app_dev_user
DB_PASSWORD=your_password_here
DB_NAME=your_app_dev_db
DB_SSL=false

# ============================================
# JWT Configuration
# ============================================
JWT_SECRET=your_dev_jwt_secret_key
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# ============================================
# CORS & URL Configuration
# ============================================
ALLOWED_ORIGINS=https://dev.your-domain.com,http://localhost:3000,http://localhost:5173
FRONTEND_BASE_URL=https://dev.your-domain.com
API_BASE_URL=https://dev-api.your-domain.com
API_TIMEOUT=30000

# ============================================
# Logging Configuration
# ============================================
LOG_LEVEL=debug

# ============================================
# SMTP Configuration (Development)
# ============================================
SMTP_HOST=your_smtp_host
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_smtp_user
SMTP_PASSWORD=your_smtp_password
SMTP_FROM="Your App (Dev) <noreply@example.com>"

# ============================================
# Firebase (Admin SDK)
# ============================================
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="your-firebase-private-key"
