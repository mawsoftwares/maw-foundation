{
  "name": "staging",
  "type": "staging",
  "branch": "release/staging",
  "server": "66.116.243.198",
  "deployPath": "/home/deploy/staging/sushmapet/backend",
  "generatedSubPath": "deployment-config",
  "processManager": {
    "name": "sushmapet-staging"
  },
  "ports": {
    "backend": 4001,
    "frontend": 3200
  },
  "domain": "staging-api.sushmapet.com",
  "database": {
    "name": "sushmapet_staging_user",
    "host": "103.211.202.236",
    "port": 5432
  },
  "features": {
    "inventory": true,
    "billing": true
  },
  "runtime": {
    "startScript": "dist/server.js",
    "instances": 1,
    "execMode": "fork",
    "maxMemoryRestart": "500M"
  },
  "ssh": {
    "user": "deploy",
    "keyPath": "~/.ssh/mac_to_doserver",
    "shellInit": "source ~/.nvm/nvm.sh"
  },
  "deployment": {
    "projectRoot": "/home/deploy/staging/sushmapet/backend",
    "repoUrl": "git@bitbucket.org:maw2025/backend_sushmapet_mfg.git",
    "pm2Command": "pm2 startOrReload {{ecosystemPath}}",
    "commands": {
      "pull": "git fetch origin && git checkout -B release/staging origin/release/staging",
      "install": "npm install",
      "build": "npm run build",
      "migrate": "node deployment/scripts/run-with-deploy-env.js deployment-config/.env npm run migrate:uat",
      "seed": "node deployment/scripts/run-with-deploy-env.js deployment-config/.env npm run seed:server"
    }
  },
  "health": {
    "protocol": "http",
    "endpoint": "/health"
  }
}
