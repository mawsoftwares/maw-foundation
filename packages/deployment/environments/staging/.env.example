# ============================================
# Staging (UAT) — Approach A (proxied-subpath)
# ============================================
# Copy: cp .env.example .env
# App: https://apps.mawsoftwares.in/billingapp-uat/
# API: https://apps.mawsoftwares.in/billingapp-uat/api

NODE_ENV=staging
PORT=3030

# ============================================
# Database Configuration (UAT)
# ============================================
# Must match app.config.json → database.host / database.port
DB_HOST=103.211.202.236
DB_PORT=5432
DB_USER=billingapp_dev_user
DB_PASSWORD=your_password_here
DB_NAME=billingapp_dev_db
DB_SSL=false
DB_TABLE_PREFIX=mawnew

# ============================================
# Session / JWT
# ============================================
SESSION_SECRET=change-me-to-a-long-random-secret
JWT_SECRET=your_uat_jwt_secret_key
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# ============================================
# CORS & URL Configuration
# ============================================
ALLOWED_ORIGINS=https://apps.mawsoftwares.in,http://localhost:3000,http://localhost:5173
FRONTEND_BASE_URL=https://apps.mawsoftwares.in/billingapp-uat
API_BASE_URL=https://apps.mawsoftwares.in/billingapp-uat
API_TIMEOUT=30000
TRUST_PROXY=true

# ============================================
# Rate limiting (UAT — slightly higher than prod defaults)
# ============================================
RATE_LIMIT_LOGIN_WINDOW_MINUTES=15
RATE_LIMIT_LOGIN_MAX_ATTEMPTS=20

# ============================================
# Seed defaults (required by seeds/002_default_superadmin.ts)
# ============================================
SUPERADMIN_EMAIL=admin@billingapp.uat
SUPERADMIN_PASSWORD=ChangeMeStrong1!

# ============================================
# Logging Configuration
# ============================================
LOG_LEVEL=info

# ============================================
# SMTP Configuration (UAT)
# ============================================
SMTP_HOST=your_smtp_host
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
SMTP_FROM="Business Vidyalay (UAT) <noreply@example.com>"

# ============================================
# Firebase (Admin SDK)
# ============================================
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="your-firebase-private-key"
