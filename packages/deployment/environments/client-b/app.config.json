{
  "name": "client-b",
  "type": "tenant",
  "hosting": {
    "topology": "dedicated-domain"
  },
  "branch": "main",
  "server": "client-b-server.example.com",
  "deployPath": "/home/deploy/client-b/backend",
  "generatedSubPath": "deployment-config",
  "processManager": {
    "name": "your-app-client-b"
  },
  "ports": {
    "backend": 4500,
    "frontend": 3500
  },
  "domain": "api.client-b.your-domain.com",
  "nginx": {
    "ssl": {
      "enabled": true,
      "listenPort": 443,
      "certificate": "/etc/letsencrypt/live/api.client-b.your-domain.com/fullchain.pem",
      "certificateKey": "/etc/letsencrypt/live/api.client-b.your-domain.com/privkey.pem",
      "redirectHttp": true,
      "acmeChallengeRoot": "/home/deploy/client-b/acme-challenge"
    }
  },
  "database": {
    "name": "your_app_client_b_db",
    "host": "localhost",
    "port": 5432
  },
  "features": {
    "inventory": false,
    "billing": true
  },
  "runtime": {
    "startScript": "dist/server.js",
    "instances": 1,
    "execMode": "fork",
    "maxMemoryRestart": "500M"
  },
  "ssh": {
    "user": "deploy",
    "keyPath": "~/.ssh/client_b_deploy",
    "shellInit": "source ~/.nvm/nvm.sh"
  },
  "deployment": {
    "projectRoot": "/home/deploy/client-b/backend",
    "repoUrl": "git@your-git-host:your-org/your-backend-repo.git",
    "pm2Command": "pm2 startOrReload {{ecosystemPath}}",
    "commands": {
      "pull": "git checkout main && git pull origin main",
      "install": "npm install",
      "build": "npm run build",
      "migrate": "node deployment/scripts/run-with-deploy-env.js deployment-config/.env npm run migrate:latest"
    }
  },
  "health": {
    "protocol": "https",
    "endpoint": "/health"
  }
}
