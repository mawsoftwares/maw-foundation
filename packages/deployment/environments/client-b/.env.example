# ============================================
# Client B (tenant) — Approach B (dedicated-domain)
# ============================================
# Copy: cp .env.example .env
# App: https://client-b.your-domain.com/
# API: https://api.client-b.your-domain.com

NODE_ENV=production
PORT=4500

# ============================================
# Database Configuration (Client B)
# ============================================
DB_HOST=your_db_host
DB_PORT=5432
DB_USER=your_app_client_b_user
DB_PASSWORD=your_password_here
DB_NAME=your_app_client_b_db
DB_SSL=false

# ============================================
# JWT Configuration
# ============================================
JWT_SECRET=your_client_b_jwt_secret_key
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# ============================================
# CORS & URL Configuration
# ============================================
ALLOWED_ORIGINS=https://client-b.your-domain.com,http://localhost:3000,http://localhost:5173
FRONTEND_BASE_URL=https://client-b.your-domain.com
API_BASE_URL=https://api.client-b.your-domain.com
API_TIMEOUT=30000

# ============================================
# Logging Configuration
# ============================================
LOG_LEVEL=info

# ============================================
# SMTP Configuration (Client B)
# ============================================
SMTP_HOST=your_smtp_host
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_smtp_user
SMTP_PASSWORD=your_smtp_password
SMTP_FROM="Client B <noreply@client-b.example.com>"

# ============================================
# Firebase (Admin SDK)
# ============================================
FIREBASE_PROJECT_ID=client-b-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@client-b-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="your-firebase-private-key"
