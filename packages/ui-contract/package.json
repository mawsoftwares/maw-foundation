{
  "name": "@mawsoftwares/ui-contract",
  "version": "1.0.0",
  "description": "Component contracts (prop types) and the UI-kit registry shared by @mawsoftwares/ui-web and alternative kits such as @mawsoftwares/ui-web-tailwind. Types + one setter; no UI code.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mawsoftwares/maw-foundation.git",
    "directory": "packages/ui-contract"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/**/*.spec.ts"
  ],
  "license": "MIT",
  "private": false,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "peerDependencies": {
    "react": "^18 || ^19"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "react": "^19.0.0"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  }
}
