{
  "name": "@mawsoftwares/testing",
  "version": "0.1.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mawsoftwares/maw-foundation.git",
    "directory": "packages/testing"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/**/*.spec.ts"
  ],
  "license": "MIT",
  "private": false,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./config": "./src/config/index.ts",
    "./mocks": "./src/mocks/index.ts",
    "./factories": "./src/factories/index.ts",
    "./matchers": "./src/matchers/index.ts",
    "./database": "./src/database/index.ts"
  },
  "dependencies": {
    "@mawsoftwares/sdk": "workspace:*"
  },
  "peerDependencies": {
    "vitest": ">=3",
    "@mawsoftwares/database": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@mawsoftwares/database": {
      "optional": true
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  }
}
