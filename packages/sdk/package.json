{
  "name": "@mawsoftwares/sdk",
  "version": "0.1.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mawsoftwares/maw-foundation.git",
    "directory": "packages/sdk"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/**/*.spec.ts"
  ],
  "license": "MIT",
  "private": false,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./kernel/*": "./src/kernel/*.ts",
    "./contracts/*": "./src/contracts/*.ts",
    "./security/*": "./src/security/*.ts",
    "./config/*": "./src/config/*.ts",
    "./queue": "./src/queue/index.ts",
    "./queue/*": "./src/queue/*.ts",
    "./i18n": "./src/i18n/index.ts",
    "./i18n/*": "./src/i18n/*.ts",
    "./modules": "./src/modules/index.ts",
    "./modules/*": "./src/modules/*.ts",
    "./offline/*": "./src/offline/*.ts",
    "./branding": "./src/branding/index.ts",
    "./branding/*": "./src/branding/*.ts",
    "./communication": "./src/communication/index.ts",
    "./communication/*": "./src/communication/*.ts",
    "./data-grid": "./src/data-grid/index.ts",
    "./data-grid/*": "./src/data-grid/*.ts",
    "./dynamic-form": "./src/dynamic-form/index.ts",
    "./dynamic-form/*": "./src/dynamic-form/*.ts",
    "./domains": "./src/domains/index.ts",
    "./domains/*": "./src/domains/*.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  }
}
