{
  "name": "@mawsoftwares/observability",
  "version": "0.1.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mawsoftwares/maw-foundation.git",
    "directory": "packages/observability"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/**/*.spec.ts"
  ],
  "license": "MIT",
  "private": false,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./context": "./src/context/index.ts",
    "./logger": "./src/logger/index.ts",
    "./metrics": "./src/metrics/index.ts",
    "./tracing": "./src/tracing/index.ts",
    "./errors": "./src/errors/index.ts",
    "./health": "./src/health/index.ts",
    "./performance": "./src/performance/index.ts",
    "./shutdown": "./src/shutdown/index.ts",
    "./config": "./src/config/index.ts",
    "./adapters/express": "./src/adapters/express/index.ts",
    "./adapters/hono": "./src/adapters/hono/index.ts",
    "./testing": "./src/testing/index.ts"
  },
  "dependencies": {
    "@mawsoftwares/sdk": "workspace:*",
    "@mawsoftwares/config": "workspace:*",
    "@mawsoftwares/platform": "workspace:*"
  },
  "peerDependencies": {
    "express": ">=5",
    "hono": ">=4"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    },
    "hono": {
      "optional": true
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  }
}
