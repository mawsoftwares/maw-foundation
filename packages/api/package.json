{
  "name": "@mawsoftwares/api",
  "version": "0.1.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mawsoftwares/maw-foundation.git",
    "directory": "packages/api"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/**/*.spec.ts"
  ],
  "license": "MIT",
  "private": false,
  "type": "module",
  "description": "Framework-agnostic API foundation — response envelope, controller contract, request context, DTOs, error translation, idempotency, OpenAPI metadata.",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./response": "./src/response/index.ts",
    "./context": "./src/context/index.ts",
    "./controller": "./src/controller/index.ts",
    "./errors": "./src/errors/index.ts",
    "./dto": "./src/dto/index.ts",
    "./dto/*": "./src/dto/*.ts",
    "./response/*": "./src/response/*.ts",
    "./idempotency": "./src/idempotency/index.ts",
    "./openapi": "./src/openapi/index.ts",
    "./versioning": "./src/versioning/index.ts",
    "./testing": "./src/testing/index.ts"
  },
  "dependencies": {
    "@mawsoftwares/sdk": "workspace:*"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  }
}
