{
  "name": "@mawsoftwares/platform",
  "version": "0.1.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mawsoftwares/maw-foundation.git",
    "directory": "packages/platform"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/**/*.spec.ts"
  ],
  "license": "MIT",
  "private": false,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./native": "./src/native/index.ts"
  },
  "dependencies": {
    "@mawsoftwares/database": "workspace:*",
    "@mawsoftwares/sdk": "workspace:*",
    "drizzle-orm": "^0.45.2"
  },
  "peerDependencies": {
    "expo-secure-store": "*",
    "@react-native-community/netinfo": "*",
    "@aws-sdk/client-s3": "^3",
    "@aws-sdk/s3-request-presigner": "^3"
  },
  "peerDependenciesMeta": {
    "expo-secure-store": {
      "optional": true
    },
    "@react-native-community/netinfo": {
      "optional": true
    },
    "@aws-sdk/client-s3": {
      "optional": true
    },
    "@aws-sdk/s3-request-presigner": {
      "optional": true
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  }
}
