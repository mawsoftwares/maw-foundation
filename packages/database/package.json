{
  "name": "@mawsoftwares/database",
  "version": "0.1.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mawsoftwares/maw-foundation.git",
    "directory": "packages/database"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/**/*.spec.ts"
  ],
  "license": "MIT",
  "private": false,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/types.ts",
    "./pool": "./src/pool/index.ts",
    "./errors": "./src/errors/index.ts",
    "./transaction": "./src/transaction/index.ts",
    "./entity": "./src/entity/index.ts",
    "./entity/mappers": "./src/entity/mappers.ts",
    "./query": "./src/query/index.ts",
    "./repository": "./src/repository/index.ts",
    "./tenant": "./src/tenant/index.ts",
    "./soft-delete": "./src/soft-delete/index.ts",
    "./migration": "./src/migration/runner.ts",
    "./seed": "./src/seed/index.ts",
    "./health": "./src/health/index.ts",
    "./testing": "./src/testing/index.ts",
    "./drizzle": "./src/drizzle/index.ts",
    "./schema": "./src/schema/index.ts",
    "./schema/*": "./src/schema/*.ts"
  },
  "dependencies": {
    "@mawsoftwares/sdk": "workspace:*",
    "drizzle-orm": "^0.45.2"
  },
  "peerDependencies": {
    "pg": ">=8"
  },
  "peerDependenciesMeta": {
    "pg": {
      "optional": true
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  }
}
